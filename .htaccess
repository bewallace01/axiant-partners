RewriteRule ^fix-and-flip-blog\.html$ /fix-and-flip/articles/ [R=301,L]
RewriteRule ^fix-and-flip/?$ /fix-and-flip/articles/ [R=301,L]
RewriteRule ^revenue-based-financing-blog\.html$ /revenue-based-financing/articles/ [R=301,L]
