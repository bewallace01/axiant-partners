RewriteRule ^securities-based-lending-blog\.html$ /securities-based-lending/articles/ [R=301,L]
RewriteRule ^securities-based-lending/?$ /securities-based-lending/articles/ [R=301,L]

# Article redirects: /blog/slug.html -> /topic/articles/slug/
