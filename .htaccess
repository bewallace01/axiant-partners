# Apache redirects (301) - blog URL migration Option C
# Enable RewriteEngine
RewriteEngine On
RewriteBase /

# Gzip compression for faster delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Glossary removed - redirect to articles hub
RewriteRule ^glossary\.html$ /blog.html [R=301,L]

# Removed basic articles - redirect to parent hub
RewriteRule ^equipment-financing/articles/how-equipment-financing-works/?$ /equipment-financing/articles/ [R=301,L]
RewriteRule ^sba-loans/articles/sba-loan-basics/?$ /sba-loans/articles/ [R=301,L]

# Hub redirects: *-blog.html -> /topic/
RewriteRule ^sba-loans-blog\.html$ /sba-loans/articles/ [R=301,L]
RewriteRule ^sba-loans/?$ /sba-loans/articles/ [R=301,L]
RewriteRule ^equipment-financing-blog\.html$ /equipment-financing/articles/ [R=301,L]
RewriteRule ^equipment-financing/?$ /equipment-financing/articles/ [R=301,L]
RewriteRule ^business-line-of-credit-blog\.html$ /business-line-of-credit/articles/ [R=301,L]
RewriteRule ^business-line-of-credit/?$ /business-line-of-credit/articles/ [R=301,L]
RewriteRule ^working-capital-loans-blog\.html$ /working-capital-loans/articles/ [R=301,L]
RewriteRule ^working-capital-loans/?$ /working-capital-loans/articles/ [R=301,L]
RewriteRule ^business-term-loans-blog\.html$ /business-term-loans/articles/ [R=301,L]
RewriteRule ^business-term-loans/?$ /business-term-loans/articles/ [R=301,L]
RewriteRule ^commercial-real-estate-loans-blog\.html$ /commercial-real-estate-loans/articles/ [R=301,L]
RewriteRule ^commercial-real-estate-loans/?$ /commercial-real-estate-loans/articles/ [R=301,L]
RewriteRule ^commercial-bridge-loans-blog\.html$ /commercial-bridge-loans/articles/ [R=301,L]
